CREATE TABLE MealEntity (
    id TEXT NOT NULL PRIMARY KEY,
    date TEXT NOT NULL,
    label TEXT NOT NULL,
    description TEXT NOT NULL,
    photoToken TEXT,
    lovedIt INTEGER NOT NULL,
    sortOrder INTEGER NOT NULL,
    FOREIGN KEY (date) REFERENCES DayEntryEntity(date)
);

selectByDate:
SELECT *
FROM MealEntity
WHERE date = ?
ORDER BY sortOrder, id;

upsert:
INSERT OR REPLACE INTO MealEntity (id, date, label, description, photoToken, lovedIt, sortOrder)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteByDate:
DELETE FROM MealEntity
WHERE date = ?;

deleteAll:
DELETE FROM MealEntity;
