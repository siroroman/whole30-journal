CREATE TABLE MetricEntity (
    date TEXT NOT NULL,
    title TEXT NOT NULL,
    iconName TEXT NOT NULL,
    value INTEGER,
    maxValue INTEGER NOT NULL,
    note TEXT NOT NULL,
    PRIMARY KEY (date, title),
    FOREIGN KEY (date) REFERENCES DayEntryEntity(date)
);

selectByDate:
SELECT *
FROM MetricEntity
WHERE date = ?
ORDER BY title;

upsert:
INSERT OR REPLACE INTO MetricEntity (date, title, iconName, value, maxValue, note)
VALUES (?, ?, ?, ?, ?, ?);

deleteByDate:
DELETE FROM MetricEntity
WHERE date = ?;

deleteAll:
DELETE FROM MetricEntity;
