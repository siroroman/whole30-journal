CREATE TABLE AchievementEntity (
    id TEXT NOT NULL PRIMARY KEY,
    date TEXT NOT NULL,
    text TEXT NOT NULL,
    sortOrder INTEGER NOT NULL,
    FOREIGN KEY (date) REFERENCES DayEntryEntity(date)
);

selectByDate:
SELECT *
FROM AchievementEntity
WHERE date = ?
ORDER BY sortOrder, id;

upsert:
INSERT OR REPLACE INTO AchievementEntity (id, date, text, sortOrder)
VALUES (?, ?, ?, ?);

deleteByDate:
DELETE FROM AchievementEntity
WHERE date = ?;

deleteAll:
DELETE FROM AchievementEntity;
