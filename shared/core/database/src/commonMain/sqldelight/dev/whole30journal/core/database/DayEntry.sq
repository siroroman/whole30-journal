CREATE TABLE DayEntryEntity (
    date TEXT NOT NULL PRIMARY KEY,
    notes TEXT NOT NULL,
    isComplete INTEGER NOT NULL DEFAULT 0
);

selectByDate:
SELECT *
FROM DayEntryEntity
WHERE date = ?;

selectInRange:
SELECT *
FROM DayEntryEntity
WHERE date BETWEEN ? AND ?
ORDER BY date;

upsert:
INSERT OR REPLACE INTO DayEntryEntity (date, notes, isComplete)
VALUES (?, ?, ?);

insertIfAbsent:
INSERT OR IGNORE INTO DayEntryEntity (date, notes, isComplete)
VALUES (?, '', 0);

deleteAll:
DELETE FROM DayEntryEntity;
